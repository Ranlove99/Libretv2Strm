# 默认按文本处理，shell 脚本与 fnOS 钩子强制 LF
* text=auto

*.sh    text eol=lf
*.bash  text eol=lf
*.json  text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf

# fnOS 打包层：无扩展名的启停脚本与向导定义必须是 LF，
# 否则在 fnOS 上执行会报 "bad interpreter: /bin/bash^M"
libretv-fpk/cmd/*     text eol=lf
libretv-fpk/wizard/*  text eol=lf
libretv-fpk/manifest  text eol=lf

# 图片与二进制
*.png   binary
*.ico   binary
*.fpk   binary
